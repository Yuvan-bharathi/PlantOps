# Dependencies
node_modules/
*/node_modules/
package-lock.json.bak

# Environment & Secrets (Never commit credentials)
.env
.env.*
!.env.example
backend/.env
frontend/.env
simulator/.env

# Production Builds & Output
dist/
*/dist/
build/
*/build/
out/
.next/
*.tsbuildinfo

