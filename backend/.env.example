# PlantOps Backend Environment Configuration Template
PORT=4000
NODE_ENV=development

# 1. TiDB Cloud (MySQL-Compatible Distributed Database)
MYSQL_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
MYSQL_PORT=4000
MYSQL_USER=your_tidb_user
MYSQL_PASSWORD=your_tidb_password
MYSQL_DATABASE=plantops_db
MYSQL_SSL=true

# 2. Timescale Cloud (High-Performance IoT Telemetry Time-Series DB)
TIMESCALE_HOST=rav1thqymh.mtkpsrohkk.tsdb.cloud.timescale.com
TIMESCALE_PORT=32670
TIMESCALE_USER=tsdbadmin
TIMESCALE_PASSWORD=your_timescale_password
TIMESCALE_DATABASE=tsdb
TIMESCALE_SSL=true

# 3. Redis Cache & Ephemeral State
REDIS_HOST=localhost
REDIS_PORT=6379

# 4. MQTT Broker (Mosquitto)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=plantops-backend
MQTT_TELEMETRY_TOPIC=plantops/machines/+/telemetry

# 5. LLM API (Groq Ultra-Fast AI Orchestrator)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
